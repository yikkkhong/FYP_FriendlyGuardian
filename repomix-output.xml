/* Scroll to bottom button */
.scroll-to-bottom-btn {
  position: absolute;
  bottom: 20px;
  right: 20px;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--manual-surface);
  border: 1px solid var(--manual-border);
  color: var(--manual-text);
  font-size: 20px;
  font-weight: 700;
