    onDeleteConversation(confirmDeleteId);
    setConfirmDeleteId(null);
  };

  return (
    <div className="manual-workspace">
      {/* [HIDDEN_FOR_PUBLIC_VERSION] Sidebar commented out for public demo */}
      {/* <aside
