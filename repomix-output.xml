/* =============================================================
 * AI insight card (AI response bubble when follow up)
 * =========================================================== */
.ai-insight-card {
  background: #ffffff;
  border: 1px solid var(--manual-border);
  border-left: 4px solid var(--manual-cta);
  border-radius: 14px;
  padding: 18px 20px 16px;
  width: 100%;
  max-width: 780px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  box-shadow: 0 2px 10px rgba(15, 118, 110, 0.04);
}

/* card header */
.insight-card-header {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.insight-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  align-self: flex-start;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.05em;
  color: var(--manual-cta);
  background: #f0f9ff;
  border: 1px solid #bae6fd;
  padding: 4px 10px;
  border-radius: 999px;
}

.insight-headline {
  font-size: 1.15rem;
  font-weight: 800;
  line-height: 1.4;
  color: var(--manual-text);
  margin: 0;
}

.insight-intro {
  font-size: 14px;
  line-height: 1.55;
  color: var(--manual-muted);
  margin: 0;
}

/* card content */
.insight-content-section {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.insight-section-title {
  font-size: 11px;
  font-weight: 800;
  color: var(--manual-muted);
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.insight-point-grid {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.insight-point-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  padding: 12px 14px;
  border-radius: 10px;
}

.point-indicator {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--manual-cta);
  margin-top: 6px;
  flex-shrink: 0;
}

.point-body {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.point-title {
  font-size: 14px;
  font-weight: 700;
  color: #0f172a;
  margin: 0;
}

.point-desc {
  font-size: 13.5px;
  line-height: 1.55;
  color: #334155;
  margin: 0;
}

/* card bottom */
.insight-takeaway-box {
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  border-radius: 10px;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.takeaway-label {
  font-size: 11px;
  font-weight: 800;
  color: #166534;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.takeaway-text {
  font-size: 13.5px;
  line-height: 1.5;
  color: #14532d;
  margin: 0;
}

/* ----------------------- */

.manual-loading-row {
  align-self: flex-start;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid var(--manual-border);
  backdrop-filter: blur(8px);
  box-shadow: 0 2px 8px rgba(15, 118, 110, 0.05);
}

.manual-loading-text {
  font-size: 13px;
  font-weight: 600;
  color: var(--manual-muted);
}

.manual-loading-dots {
  display: inline-flex;
  gap: 4px;
}

.manual-loading-dots span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--manual-primary);
  animation: manual-dot-pulse 1.2s ease-in-out infinite;
}

.manual-loading-dots span:nth-child(2) {
  animation-delay: 0.15s;
}
.manual-loading-dots span:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes manual-dot-pulse {
  0%,
  80%,
  100% {
    opacity: 0.3;
    transform: translateY(0);
  }
  40% {
    opacity: 1;
    transform: translateY(-3px);
  }
}

@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }

  .manual-loading-dots span,
  .manual-new-chat-btn,
  .manual-conversation-item,
  .manual-msg-row,
  .manual-empty-state,
  .manual-composer {
    animation: none;
    transition: none;
  }
}

/* Composer wrapper: fully transparent, anchors composer to bottom */
.manual-composer-wrapper {
  background: none !important;
  border: none !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  box-shadow: none !important;
  position: sticky;
  bottom: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  z-index: 30;
  pointer-events: none;
  padding-bottom: max(20px, env(safe-area-inset-bottom));
  padding-top: 8px;
}

.manual-composer {
  pointer-events: auto;
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1px solid rgba(0, 0, 0, 0.08);
  border-radius: 28px;
  box-shadow:
    0 1px 2px rgba(0, 0, 0, 0.04),
    0 8px 24px -8px rgba(0, 0, 0, 0.10);
  flex-shrink: 0;
  gap: 8px;
  width: calc(100% - 32px);
  max-width: 1000px;
  margin: 0 16px;
  padding: 6px 8px 6px 12px;
  box-sizing: border-box;
  transition:
    box-shadow var(--motion-fast) var(--ease-smooth),
    border-color var(--motion-fast) var(--ease-smooth);
}

.manual-composer:focus-within {
  box-shadow:
    0 0 0 3px rgba(15, 118, 110, 0.18),
    0 8px 24px -8px rgba(0, 0, 0, 0.12);
  border-color: rgba(15, 118, 110, 0.35);
}

.manual-file-input {
  display: none;
}

.manual-workspace .query-input {
  flex: 1;
  border: none;
  outline: none;
  box-shadow: none;
  font-size: 17px;
  line-height: 24px;
  color: var(--manual-text);
  background: transparent;
  font-family: inherit;
  min-width: 0;
  padding: 10px 8px;
  margin: 0;
  display: block;
}

.manual-workspace .query-input::placeholder {
  color: #94a3b8;
  line-height: 24px;
}

.manual-workspace .query-submit-action {
  height: 44px;
  border-radius: 22px;
  padding: 0 20px;
  border: none;
  outline: none;
  font-weight: 600;
  font-size: 15px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  flex-shrink: 0;
  transition:
    opacity var(--motion-fast) var(--ease-smooth),
    background-color var(--motion-fast) var(--ease-smooth),
    transform var(--motion-fast) var(--ease-press);
  font-family: inherit;
}

.manual-workspace .query-submit-action:disabled {
  background-color: #e2e8f0;
  color: #94a3b8;
  opacity: 0.7;
  cursor: not-allowed;
}

.manual-workspace .query-submit-action:not(:disabled) {
  background-color: #0f766e;
  color: #ffffff;
  opacity: 1;
}

.manual-workspace .query-submit-action:hover:not(:disabled) {
  background-color: #0d6861;
}

.manual-workspace .query-submit-action:active:not(:disabled) {
  transform: scale(0.96);
}

.manual-workspace .query-submit-action:focus-visible {
  outline: none;
  box-shadow: var(--focus-ring);
}

/* Camera and mic buttons: IDENTICAL 44x44 transparent circles with 22px brand teal icons */
.manual-workspace .query-upload-btn,
.manual-workspace .query-voice-btn {
  width: 44px !important;
  height: 44px !important;
  min-width: 44px;
  min-height: 44px;
  border-radius: 50% !important;
  background: transparent !important;
  border: none !important;
  outline: none;
  padding: 0 !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  color: #0f766e !important;
  cursor: pointer;
  transition:
    background-color var(--motion-fast) var(--ease-smooth),
    transform var(--motion-fast) var(--ease-press);
  flex-shrink: 0;
  position: relative;
}

.manual-workspace .query-upload-btn:hover:not(:disabled),
.manual-workspace .query-voice-btn:hover:not(:disabled) {
  background: rgba(15, 118, 110, 0.08) !important;
}

.manual-workspace .query-upload-btn:active:not(:disabled),
.manual-workspace .query-voice-btn:active:not(:disabled) {
  transform: scale(0.94) !important;
}

.manual-workspace .query-upload-btn:disabled,
.manual-workspace .query-voice-btn:disabled {
  cursor: not-allowed;
  opacity: 0.35;
}

/* when using voice input, red color bg, soft animation */
.manual-workspace .query-voice-btn.is-listening {
  color: var(--manual-danger);
  background-color: var(--manual-danger-bg);
  animation: pulse-voice 1.5s ease-in-out infinite;
}

@keyframes pulse-voice {
  0%,
  100% {
    transform: scale(1);
    background-color: var(--manual-danger-bg);
  }
  50% {
    transform: scale(1.08);
    background-color: #fee2e2;
  }
}

