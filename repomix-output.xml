  const mockActiveConv = {
    id: "CHAT-101",
    title: "Dangerous Scam Message",
    topic: "Scam Messages",
    summary: "User asking about suspicious bank account and SMS.",
  };

  const mockAllConvs = [
    mockActiveConv,
    {
      id: "CHAT-202",
