                if (!val.trim()) {
                  isVoiceInputRef.current = false;
                }
              }}
              onKeyDown={(e) => {
                if (e.key === "Escape") {
                  if (voicePanelActive) {
                    handleCancelVoice();
                  } else {
                    setQueryInput("");
                  }
                }
                if (e.key === "Enter" && !e.shiftKey) {
                  e.preventDefault();
                  if (voicePanelActive) {
                    handleFinishVoice();
                  } else if (queryInput.trim() && !isLoading) {
                    handleSubmit(e);
                  }
                }
              }}
              disabled={isLoading}
              autoComplete="off"
              rows={1}
              style={{
                resize: "none",
                height: "auto",
                minHeight: "44px",
                maxHeight: "150px",
                overflowY: "auto",
              }}
            />

            {/* Live timer when speaking */}
            {voicePanelActive && (
              <span className="composer-voice-timer" aria-live="off">
