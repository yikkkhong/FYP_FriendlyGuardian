/* Ensure manual workspace sits above the aurora */
.manual-workspace {
  position: relative;
  z-index: 2;
}

/* =============================================================
 * PHASE 3a — GUARDIAN ORB
 * =========================================================== */
.guardian-orb {
  width: 88px;
  height: 88px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #5eead4, #0f766e 60%, #134e4a);
  box-shadow:
    0 0 0 10px rgba(15, 118, 110, 0.1),
    0 0 32px rgba(15, 118, 110, 0.28),
    inset 0 6px 16px rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24px;
  animation: orb-breathe 4s ease-in-out infinite;
  flex-shrink: 0;
}

.guardian-orb .manual-empty-mark {
  width: 44px;
  height: 44px;
  margin: 0;
  animation: none;
}

/* override the SVG inner circles for white-on-orb look */
.guardian-orb .manual-empty-mark circle:first-child {
  fill: rgba(255,255,255,0.15);
}
.guardian-orb .manual-empty-mark circle:nth-child(2) {
  fill: rgba(255,255,255,0.25);
}

@keyframes orb-breathe {
  0%, 100% { transform: scale(1); box-shadow: 0 0 0 10px rgba(15,118,110,.1), 0 0 32px rgba(15,118,110,.28), inset 0 6px 16px rgba(255,255,255,.22); }
  50%       { transform: scale(1.04); box-shadow: 0 0 0 14px rgba(15,118,110,.07), 0 0 48px rgba(15,118,110,.22), inset 0 6px 16px rgba(255,255,255,.22); }
}

/* =============================================================
 * PHASE 3b — HERO HEADLINE + STAGGERED ENTRANCE
 * =========================================================== */

/* Override hero headline to use clamp size */
.manual-empty-state h2 {
  font-size: clamp(28px, 5vw, 44px);
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--manual-text);
  margin-bottom: 14px;
  line-height: 1.15;
  /* stagger item 2 */
  opacity: 0;
  transform: translateY(14px);
  filter: blur(4px);
  animation: hero-enter var(--dur-slow) var(--ease-out) 0.07s forwards;
}

.manual-empty-state p:not(.hero-no-signup) {
  opacity: 0;
  transform: translateY(14px);
  filter: blur(4px);
  animation: hero-enter var(--dur-slow) var(--ease-out) 0.14s forwards;
}

.guardian-orb {
  opacity: 0;
  animation: hero-enter var(--dur-slow) var(--ease-out) 0s forwards,
             orb-breathe 4s ease-in-out 0.7s infinite;
}

.manual-suggestion-chips {
  opacity: 0;
  animation: hero-enter var(--dur-slow) var(--ease-out) 0.21s forwards;
}

.hero-no-signup {
  opacity: 0;
  animation: hero-enter var(--dur-slow) var(--ease-out) 0.28s forwards;
}

@keyframes hero-enter {
  to {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
}

/* No sign-up line styling */
.hero-no-signup {
  font-size: 13px;
  color: var(--manual-muted);
  margin-top: 20px;
  letter-spacing: 0.01em;
}

/* =============================================================
 * PHASE 3b — SOLID WHITE CHIPS (NO BLUR, BRAND BORDER)
 * =========================================================== */
.manual-suggestion-chip {
  background: #ffffff !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  border: 1px solid rgba(15, 118, 110, 0.18) !important;
  font-size: 14px;
  min-height: 44px;
  box-shadow: none !important;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.manual-suggestion-chip svg {
  color: #0f766e;
  stroke: #0f766e;
  flex-shrink: 0;
}

.manual-suggestion-chip:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(15, 118, 110, 0.1) !important;
  background: #ffffff !important;
  border-color: #0f766e !important;
}

.manual-suggestion-chip:active:not(:disabled) {
  transform: scale(0.97);
}

/* =============================================================
 * PHASE 3b — COMPOSER POLISH
 * =========================================================== */
.manual-composer {
  border-radius: 28px !important;
  background: #ffffff !important;
  border: 1px solid rgba(0, 0, 0, 0.08) !important;
  box-shadow:
    0 1px 2px rgba(0, 0, 0, 0.04),
    0 8px 24px -8px rgba(0, 0, 0, 0.10) !important;
}

.manual-composer:focus-within {
  box-shadow:
    0 0 0 3px rgba(15, 118, 110, 0.18),
    0 8px 24px -8px rgba(0, 0, 0, 0.12) !important;
  border-color: rgba(15, 118, 110, 0.35) !important;
}

/* Send button: spring-in when text is present */
.manual-workspace .query-submit-action:not(:disabled) {
  animation: send-spring var(--dur-base) var(--ease-spring-bouncy);
}

@keyframes send-spring {
  from { transform: scale(0.9); }
  to   { transform: scale(1); }
}

/* =============================================================
 * PHASE 3c — MESSAGE ANIMATIONS
 * =========================================================== */
.manual-msg-row {
  animation: msg-enter var(--dur-slow) var(--ease-out) both;
}

@keyframes msg-enter {
  from {
    opacity: 0;
    transform: translateY(12px);
    filter: blur(4px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
}

/* AI thinking indicator */
.manual-loading-row {
  animation: msg-enter var(--dur-base) var(--ease-out) both;
}

/* Verdict glow on threat cards */
.threat-report-card.risk-high {
  animation: verdict-appear var(--dur-slow) var(--ease-out) both;
  box-shadow: 0 0 0 0 rgba(185, 28, 28, 0);
  transition: box-shadow var(--dur-base) var(--ease-smooth);
}
.threat-report-card.risk-high:hover {
  box-shadow: 0 0 24px rgba(185, 28, 28, 0.14);
}

.threat-report-card.risk-medium {
  animation: verdict-appear var(--dur-slow) var(--ease-out) both;
}
.threat-report-card.risk-medium:hover {
  box-shadow: 0 0 24px rgba(180, 83, 9, 0.14);
}

.threat-report-card.risk-low,
.threat-report-card.risk-safe {
  animation: verdict-appear var(--dur-slow) var(--ease-out) both;
}
.threat-report-card.risk-low:hover,
.threat-report-card.risk-safe:hover {
  box-shadow: 0 0 24px rgba(4, 120, 87, 0.14);
}

@keyframes verdict-appear {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* Streaming typewriter cursor */
.streaming-cursor {
  display: inline-block;
  color: var(--manual-primary);
  font-size: 0.85em;
  line-height: 1;
  margin-left: 2px;
  vertical-align: baseline;
  animation: cursor-blink 0.5s infinite alternate;
}

@keyframes cursor-blink {
  from {
    opacity: 1;
  }
  to {
    opacity: 0.15;
  }
}

/* =============================================================
 * PHASE 4 — RESPONSIVE VERIFICATION
 * =========================================================== */

/* Mobile: hide "New check" text label; show icon only */
@media (max-width: 600px) {
  .header-new-check-btn .btn-label {
    display: none;
  }
  .header-new-check-btn {
    width: 36px;
    height: 36px;
    padding: 0;
    border-radius: 50%;
    justify-content: center;
  }

  /* Chips: 2-column grid on mobile */
  .manual-suggestion-chips {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  /* [HIDDEN_FOR_PUBLIC_VERSION] Voice panel full width on mobile commented out */
  /* .manual-composer.is-voice-active {
    width: calc(100% - 24px) !important;
  } */
}

/* Safe area bottom for composer on iOS */
.manual-composer-wrapper {
  padding-bottom: max(20px, env(safe-area-inset-bottom, 0px));
}

/* dvh fix for stream viewport */
@supports (height: 100dvh) {
  .canvas-root {
    height: 100dvh;
  }
}

/* =============================================================
 * PHASE 3 — REDUCED MOTION
 * =========================================================== */
@media (prefers-reduced-motion: reduce) {
  .aurora-orb,
  .guardian-orb {
    animation: none !important;
  }
  .guardian-orb {
    opacity: 1;
  }
  .manual-empty-state h2,
  .manual-empty-state p,
  .manual-suggestion-chips,
  .hero-no-signup {
    opacity: 1;
    transform: none;
    filter: none;
    animation: none !important;
  }
  @keyframes hero-enter {
    to { opacity: 1; transform: none; filter: none; }
  }
  .manual-msg-row,
  .manual-loading-row {
    animation: none;
  }
}
