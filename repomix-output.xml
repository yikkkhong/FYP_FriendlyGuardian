                {isLoading ? "…" : "Send"}
              </button>
            )}
          </form>
        </div>
      </section>

      {confirmDeleteId && (
        <div className="manual-confirm-backdrop" role="presentation">
          <div
            className="manual-confirm-dialog"
            role="alertdialog"
