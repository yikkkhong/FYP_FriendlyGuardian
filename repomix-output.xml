.manual-empty-state {
  margin: auto;
  text-align: center;
  max-width: 480px;
  padding: 48px 24px;
  /* Staggered per-element entrance animations handle the reveal instead */
}

@keyframes fade-in-up {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.manual-empty-mark {
  width: 64px;
  height: 64px;
  margin-bottom: 20px;
  animation: scale-in var(--motion-medium) var(--ease-spring);
}

@keyframes scale-in {
  from {
    opacity: 0;
    transform: scale(0.8);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.manual-empty-state h2 {
  /* Overridden by Phase 3b rule below with clamp + entrance animation */
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--manual-text);
  margin-bottom: 12px;
  letter-spacing: -0.02em;
}

.manual-empty-state p {
  font-size: 16px;
  line-height: 1.6;
  color: var(--manual-muted);
  margin-bottom: 24px;
}

/* Suggestion chips for empty state */
.manual-suggestion-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: center;
  margin-top: 24px;
}

.manual-suggestion-chip {
  border: 1px solid var(--manual-border);
  background: var(--manual-surface);
  color: var(--manual-text);
  font: inherit;
  font-size: 14px;
  font-weight: 600;
  padding: 10px 16px;
  border-radius: 999px;
  cursor: pointer;
  transition:
    background-color var(--motion-fast) var(--ease-smooth),
    border-color var(--motion-fast) var(--ease-smooth),
    transform var(--motion-fast) var(--ease-press),
    box-shadow var(--motion-fast) var(--ease-smooth);
  animation: chip-fade-in var(--motion-medium) var(--ease-spring) backwards;
}

.manual-suggestion-chip:nth-child(1) {
  animation-delay: 0.1s;
}

.manual-suggestion-chip:nth-child(2) {
  animation-delay: 0.2s;
}

.manual-suggestion-chip:nth-child(3) {
  animation-delay: 0.3s;
}

.manual-suggestion-chip:nth-child(4) {
  animation-delay: 0.4s;
}

@keyframes chip-fade-in {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.manual-suggestion-chip:hover:not(:disabled) {
  background: var(--manual-primary-soft);
  border-color: #99f6e4;
  box-shadow: 0 2px 8px rgba(15, 118, 110, 0.1);
}

.manual-suggestion-chip:active:not(:disabled) {
  transform: scale(0.96);
}

.manual-suggestion-chip:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.manual-suggestion-chip:focus-visible {
  outline: none;
  box-shadow: var(--focus-ring);
}

.manual-msg-row {
  display: flex;
  flex-direction: column;
  max-width: 100%;
  width: 100%;
  animation: message-enter var(--motion-medium) var(--ease-spring);
}

@keyframes message-enter {
  from {
    opacity: 0;
    transform: translateY(12px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.manual-msg-row.user {
  align-self: flex-end;
  align-items: flex-end;
  max-width: min(100%, 640px);
}

.manual-msg-row.ai {
  align-self: stretch;
  align-items: flex-start;
  max-width: 100%;
}

.manual-msg-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 5px;
  padding: 0 2px;
}

.meta-label {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.manual-msg-row.user .meta-label {
  color: var(--manual-cta);
}

.manual-msg-row.ai .meta-label {
  color: var(--manual-primary);
}

.meta-time {
  font-size: 12px;
  color: #64748b;
}

.user-query-bubble {
  background: #0f172a;
  color: #fff;
  padding: 14px 18px;
  border-radius: 18px 18px 6px 18px;
  font-size: 17px;
  line-height: 1.55;
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-width: 100%;
}

.manual-image-preview-link {
  display: block;
  border-radius: 10px;
  overflow: hidden;
  line-height: 0;
}

.manual-image-preview {
  display: block;
  max-width: min(100%, 320px);
  max-height: 240px;
  width: auto;
  height: auto;
  object-fit: contain;
  background: #1e293b;
}

.manual-image-caption {
  font-size: 12px;
  opacity: 0.75;
}

.threat-report-card {
  background: #fff;
  border: 1px solid var(--manual-border);
  border-left: 4px solid var(--manual-primary);
  border-radius: 14px;
  padding: 16px 16px 14px;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 14px;
  box-shadow: none;
}

.threat-report-card.risk-high {
  border-left-color: var(--manual-danger);
  background: linear-gradient(180deg, var(--manual-danger-bg) 0%, #fff 50%);
}

.threat-report-card.risk-medium {
  border-left-color: var(--manual-warn);
  background: linear-gradient(180deg, var(--manual-warn-bg) 0%, #fff 50%);
}

.threat-report-card.risk-low,
.threat-report-card.risk-safe {
  border-left-color: var(--manual-safe);
  background: linear-gradient(180deg, var(--manual-safe-bg) 0%, #fff 50%);
}

.report-verdict {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.report-verdict-copy h3 {
  font-size: 1.05rem;
  font-weight: 800;
  line-height: 1.35;
  letter-spacing: -0.01em;
  color: var(--manual-text);
  margin-bottom: 4px;
}

.report-verdict-copy p {
  font-size: 14px;
  line-height: 1.5;
  color: var(--manual-muted);
}

.risk-level-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.02em;
  padding: 7px 11px;
  border-radius: 999px;
}

.manual-risk-icon {
  width: 16px;
  height: 16px;
}

.risk-level-badge.high {
  background: rgba(185, 28, 28, 0.12);
  color: var(--manual-danger);
  border: 1px solid rgba(185, 28, 28, 0.28);
}

.risk-level-badge.medium {
  background: rgba(180, 83, 9, 0.12);
  color: var(--manual-warn);
  border: 1px solid rgba(180, 83, 9, 0.28);
}

.risk-level-badge.low,
.risk-level-badge.safe {
  background: rgba(4, 120, 87, 0.12);
  color: var(--manual-safe);
  border: 1px solid rgba(4, 120, 87, 0.28);
}

.report-section {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.report-section-action {
  background: #f8fffd;
  border: 1px solid var(--manual-border);
  border-radius: 12px;
  padding: 12px 14px;
}

.section-label {
  font-size: 12px;
  font-weight: 800;
  color: var(--manual-muted);
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.report-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.report-list li {
  font-size: 15px;
  line-height: 1.55;
  color: var(--manual-text);
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.report-list li::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 50%;
  margin-top: 8px;
  flex-shrink: 0;
  background: var(--manual-primary);
}

.report-list.alert-list li::before {
  background: var(--manual-danger);
}

.threat-report-card.risk-medium .report-list.alert-list li::before {
  background: var(--manual-warn);
}

.threat-report-card.risk-low .report-list.alert-list li::before,
.threat-report-card.risk-safe .report-list.alert-list li::before {
  background: var(--manual-safe);
}

.report-list.action-list li::before {
  background: var(--manual-cta);
}

/* Normal Asking Question Bubble  */
.plain-ai-bubble {
  background: transparent;
  border: none;
  color: var(--manual-text);
  padding: 2px 2px;
  border-radius: 0;
  font-size: 17px;
  line-height: 1.6;
  max-width: 42rem;
  white-space: pre-wrap;
}

