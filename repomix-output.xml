import CompanionView from "./views/CompanionView";
import { io, Socket } from "socket.io-client";
import "./companionDesign.css";

//Define a global persistent reference at the top of App.tsx (outside the component)
// to prevent it from being garbage-collected by Chrome V8
let globalUtterance: SpeechSynthesisUtterance | null = null;

interface ScamAlertData {
  text: string;
  sender: string;
  detected_account: string;
  reason: string;
  baymax_message: string;
  suggested_emotion: EmotionState;
  timestamp: string;
}

let socket: Socket;

const App_CompanionBackup: React.FC = () => {
  const [aiEmotion, setAiEmotion] = useState<EmotionState>("HAPPY");
  const [isSpeaking, setIsSpeaking] = useState<boolean>(false);
  const [showAlert, setShowAlert] = useState<boolean>(false);
  const [alertData, setAlertData] = useState<ScamAlertData | null>(null);
  const [baymaxResponse, setBaymaxResponse] = useState<string>(
    "Hello! I am Baymax, your guardian companion. You are completely safe with me.",
  );
  const [isWaitingAi, setIsWaitingAi] = useState<boolean>(false);

  const [isConnected, setIsConnected] = useState<boolean>(false);
  const [blockedCount, setBlockedCount] = useState<number>(12);

  useEffect(() => {
    socket = io("http://localhost:5000");

    socket.on("connect", () => {
      setIsConnected(true);
      socket.emit("manual_list_conversations");
    });
    socket.on("disconnect", () => setIsConnected(false));

    socket.on("scam_alert", (data: ScamAlertData) => {
      setAlertData(data);
      setShowAlert(true);
      setAiEmotion(data.suggested_emotion || "ALERT");
      const msg =
        data.baymax_message ||
        `Caution! Intercepted an anomaly from ${data.sender}`;
      setBaymaxResponse(msg);
      speakText(msg);
    });

    socket.on(
      "baymax_chat_response",
      (data: { baymax_message: string; suggested_emotion: EmotionState }) => {
        setBaymaxResponse(data.baymax_message);
        setAiEmotion(data.suggested_emotion || "HAPPY");
        speakText(data.baymax_message);
        setIsWaitingAi(false);
      },
    );
    return () => {
      socket.disconnect();
    };
  }, []);

  const speakText = (text: string) => {
    if (!("speechSynthesis" in window)) {
      console.warn("⚠️ Current browser does not support SpeechSynthesis");
      return;
    }

    try {
      window.speechSynthesis.cancel();

      if (window.speechSynthesis.paused) {
        window.speechSynthesis.resume();
      }

      const utterance = new SpeechSynthesisUtterance(text);
      globalUtterance = utterance;

      utterance.pitch = 1.0;
      utterance.rate = 0.95;
      utterance.lang = "en-US";

      utterance.onstart = () => {
        console.log("🔊 Baymax starts speaking...");
        setIsSpeaking(true);
      };
      utterance.onend = () => {
        console.log("🔊 Baymax finished speaking...");
        setIsSpeaking(false);
        globalUtterance = null;
      };
      utterance.onerror = (e) => {
        console.error("❌ SpeechSynthesis Error:", e);
        setIsSpeaking(false);
        globalUtterance = null;
      };

      window.speechSynthesis.speak(utterance);

      if (window.speechSynthesis.paused) {
        window.speechSynthesis.resume();
      }
    } catch (err) {
      console.error("🔥 speakText Exception:", err);
      setIsSpeaking(false);
    }
  };

  const handleSendMessage = (text: string) => {
    // moved to CompanionView handleSubmit
    // e.preventDefault();
    // if (!chatInput.trim() || isWaitingAi) return;

    setIsWaitingAi(true);
    setAiEmotion("THINKING");
    const pendingText = "Processing your query...";
    setBaymaxResponse(pendingText);

    if (socket && socket.connected) {
      socket.emit("user_chat", { text });
    } else {
      // fallback
      setTimeout(() => {
        setIsWaitingAi(false);
        setAiEmotion("NEUTRAL");
        const reply = "Server is offline, please try again later.";
        setBaymaxResponse(reply);
        speakText(reply);
      }, 1200);
    }
    //setChatInput("");
  };

  const handleBlock = () => {
    setShowAlert(false);
    setBlockedCount((prev) => prev + 1);
    setAiEmotion("HAPPY");
    const msg = "Threat blocked! You are safe now. What else can I do for you?";
    setBaymaxResponse(msg);
    speakText(msg);
  };

  return (
    <div className="canvas-root" data-mode="ELDERLY">
      {" "}
      {/*{appMode} */}
      {/* top nav bar */}
      <header className="control-bar-wrapper">
        <div className="control-bar">
          <div className="brand-group">
            <span className="brand-pill">Friendly Guardian</span>
            <div className="connection-indicator">
              <span
                className={`pulse-dot ${isConnected ? "online" : "offline"}`}
              />
              <span className="status-label">
                {isConnected ? "ONLINE" : "OFFLINE"}
              </span>
            </div>
          </div>
        </div>
      </header>
      {/* main part */}
      <main className="stage-viewport">
        <CompanionView
          aiEmotion={aiEmotion}
          isSpeaking={isSpeaking}
          baymaxResponse={baymaxResponse}
          isWaitingAi={isWaitingAi}
          onSendMessage={handleSendMessage}
        />
      </main>
      {/* bottom panel, emotion tester */}
      {/* {appMode === "ELDERLY" && ( */}
      <footer className="footer-utility-bar">
        <div className="emotion-tuner">
          <span className="tuner-title">STATE TUNER:</span>
          <button
            onClick={() => {
              setAiEmotion("HAPPY");
              const m = "I am at your service and feeling bright!";
              setBaymaxResponse(m);
              speakText(m);
            }}
            className={`tune-chip ${aiEmotion === "HAPPY" ? "chip-active" : ""}`}
          >
            Happy
          </button>
          <button
            onClick={() => {
              setAiEmotion("NEUTRAL");
              const m = "Calm and standing by.";
              setBaymaxResponse(m);
              speakText(m);
            }}
            className={`tune-chip ${aiEmotion === "NEUTRAL" ? "chip-active" : ""}`}
          >
            Neutral
          </button>
          <button
            onClick={() => {
              setAiEmotion("THINKING");
              const m = "Processing your request...";
              setBaymaxResponse(m);
              speakText(m);
            }}
            className={`tune-chip ${aiEmotion === "THINKING" ? "chip-active" : ""}`}
          >
            Thinking
          </button>
          <button
            onClick={() => {
              setAiEmotion("ALERT");
              const m = "Attention! Security discrepancy located!";
              setBaymaxResponse(m);
              speakText(m);
            }}
            className={`tune-chip alert-chip ${aiEmotion === "ALERT" ? "chip-active" : ""}`}
          >
            Alert
          </button>
        </div>
      </footer>
      {/* )} */}
      {/* alert pop up */}
      {showAlert && alertData && (
        <div className="modal-backdrop-blur">
          <div className="tactile-alert-sheet">
            <div className="sheet-stripe" />
            <h3 className="alert-sheet-title">CRITICAL RISK INTERCEPT</h3>
            <div className="sheet-field">
              <span className="field-lbl">SUSPECT ACCOUNT</span>
              <span className="field-val">{alertData.detected_account}</span>
            </div>
            <div className="sheet-quote">“{alertData.text}”</div>
            <button onClick={handleBlock} className="safety-resolve-btn">
              BLOCK & DISMISS SENDER
            </button>
          </div>
        </div>
      )}
    </div>
  );
};

export default App_CompanionBackup;
</file>

<file path="frontend/src/archive/companionDesign.css">
/* -------------------------------------------------------------
 * 1. DESIGN SYSTEM & REFINED LIGHT FOUNDATION
 * ----------------------------------------------------------- */
:root {
  --canvas-bg: #f5f4ee;
  --surface-white: #ffffff;
  --surface-subtle: #edeae1;
  --ink-primary: #18191b;
  --ink-secondary: #636773;
  --ink-tertiary: #9297a5;
  --border-line: #e2dfd2;
  --border-line-hover: #c9c5b5;
  --accent-cobalt: #2563eb;
  --accent-red: #dc2626;
  --accent-green: #059669;
  --accent-amber: #d97706;

  --cubic-spring: cubic-bezier(0.16, 1, 0.3, 1);
  --shadow-tactile:
    0 12px 30px -8px rgba(0, 0, 0, 0.04), 0 2px 6px rgba(0, 0, 0, 0.02);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: var(--canvas-bg);
  color: var(--ink-primary);
  font-family:
    -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto,
    sans-serif;
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
}

.canvas-root {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  background-image: radial-gradient(rgba(0, 0, 0, 0.035) 1px, transparent 1px);
  background-size: 24px 24px;
}

/* -------------------------------------------------------------
 * 2. TOP FLOATING CONTROL BAR
 * ----------------------------------------------------------- */
.control-bar-wrapper {
  position: absolute;
  top: 20px;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  z-index: 50;
  pointer-events: none;
}

.control-bar {
  pointer-events: auto;
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 6px 14px 6px 18px;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(16px);
  border: 1px solid var(--border-line);
  border-radius: 999px;
  box-shadow: var(--shadow-tactile);
}

.brand-group {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-pill {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
  color: var(--ink-primary);
  font-family: ui-monospace, SFMono-Regular, monospace;
}

.connection-indicator {
  display: flex;
  align-items: center;
  gap: 6px;
  padding-left: 10px;
  border-left: 1px solid var(--border-line);
}

.pulse-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
}
.pulse-dot.online {
  background-color: var(--accent-green);
  box-shadow: 0 0 8px rgba(5, 150, 105, 0.5);
}
.pulse-dot.offline {
  background-color: var(--accent-red);
}

.status-label {
  font-size: 10px;
  font-weight: 700;
  color: var(--ink-secondary);
  font-family: ui-monospace, monospace;
}

/* cut from App.css  */
.mode-segmented-pill {
  display: flex;
  background-color: var(--surface-subtle);
  padding: 3px;
  border-radius: 999px;
  gap: 2px;
}

.segment-btn {
  border: none;
  background: transparent;
  padding: 6px 14px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  color: var(--ink-secondary);
  cursor: pointer;
  transition: all 0.2s ease;
}

.segment-btn.selected {
  background-color: var(--surface-white);
  color: var(--ink-primary);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

/* -------------------------------------------------------------
 * 3. HARDWARE PIXEL CHASSIS
 * ----------------------------------------------------------- */
.pixel-chassis {
  width: 440px;
  height: 440px;
  border-radius: 44px;
  border: 3px solid;
  padding: 24px;
  display: flex;
  flex-direction: column;
  transition: all 0.5s var(--cubic-spring);
  user-select: none;
}

.chassis-hardware-badge {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
  padding: 0 4px;
}

.badge-text {
  font-size: 9px;
  letter-spacing: 1.5px;
  font-weight: 800;
  color: var(--ink-tertiary);
  font-family: ui-monospace, monospace;
}

.dot-screws {
  width: 5px;
  height: 5px;
  background: var(--border-line-hover);
  border-radius: 50%;
}

.matrix-viewport {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(16, 1fr);
  grid-template-rows: repeat(16, 1fr);
  gap: 4.5px;
}

.pixel-cell {
  width: 100%;
  height: 100%;
  border-radius: 3px;
  transition:
    background-color 0.12s ease,
    transform 0.2s ease;
}

/* -------------------------------------------------------------
 * 4. STAGE THEATRE & FLUID KINETIC TRANSITION
 * ----------------------------------------------------------- */
.stage-viewport {
  flex: 1;
  min-height: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 76px 24px 20px 24px;
  position: relative;
  overflow: hidden;
}

.experience-theatre {
  width: 100%;
  max-width: 1200px;
  height: 100%;
  display: flex;
  align-items: center;
  position: relative;
  /* transition: all 0.65s var(--cubic-spring); */
  transition: all 0.75s cubic-bezier(0.16, 1, 0.3, 1);
}

/* 4A. (CENTERED */
.experience-theatre.layout-centered {
  justify-content: center;
}

.experience-theatre.layout-centered .actor-face-zone {
  transform: translate3d(0, 0, 0) scale(1.1);
  transition: transform 0.65s var(--cubic-spring);
}

.experience-theatre.layout-centered .actor-dialogue-zone {
  position: absolute;
  bottom: 12px;
  width: 100%;
  max-width: 540px;
  opacity: 0.95;
  transform: translateY(0);
  transition: all 0.5s var(--cubic-spring);
}

.experience-theatre.layout-centered .speech-caption-card {
  display: none; /* */
}

/* 4B. When talking, then split */
.experience-theatre.layout-split {
  justify-content: space-between;
}

.experience-theatre.layout-split .actor-face-zone {
  flex: 0 0 45%;
  display: flex;
  justify-content: center;
  align-items: center;
  transform: translate3d(-10px, 0, 0) scale(0.88);
  transition: transform 0.65s var(--cubic-spring);
}

.experience-theatre.layout-split .actor-dialogue-zone {
  flex: 0 0 52%;
  display: flex;
  flex-direction: column;
  gap: 20px;
  animation: dialogueEnter 0.5s var(--cubic-spring) forwards;
}

@keyframes dialogueEnter {
  from {
    opacity: 0;
    transform: translate3d(24px, 0, 0);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

/* -------------------------------------------------------------
 * 5. DIALOGUE & KINETIC SUBTITLES
 * ----------------------------------------------------------- */
.speech-caption-card {
  background: var(--surface-white);
  border: 1px solid var(--border-line);
  padding: 36px 38px;
  border-radius: 32px;
  box-shadow: var(--shadow-tactile);
  position: relative;
}

.speech-badge-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
}

.dialogue-tag {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.2px;
  color: var(--accent-cobalt);
  font-family: ui-monospace, monospace;
}

.voice-waves {
  display: flex;
  align-items: center;
  gap: 3px;
}

.voice-waves span {
  width: 3px;
  height: 12px;
  background-color: var(--accent-cobalt);
  border-radius: 2px;
  animation: waveBounce 0.8s ease-in-out infinite alternate;
}
.voice-waves span:nth-child(2) {
  animation-delay: 0.15s;
  height: 18px;
}
.voice-waves span:nth-child(3) {
  animation-delay: 0.3s;
  height: 14px;
}
.voice-waves span:nth-child(4) {
  animation-delay: 0.45s;
  height: 8px;
}

@keyframes waveBounce {
  from {
    transform: scaleY(0.4);
    opacity: 0.5;
  }
  to {
    transform: scaleY(1.3);
    opacity: 1;
  }
}

.caption-body-text {
  font-size: 26px;
  line-height: 1.45;
  font-weight: 700;
  letter-spacing: -0.3px;
  color: var(--ink-primary);
}

/* input field */
.bottom-query-capsule {
  display: flex;
  background: var(--surface-white);
  border: 1px solid var(--border-line);
  padding: 6px 8px 6px 18px;
  border-radius: 999px;
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
}

.query-input {
  flex: 1;
  border: none;
  outline: none;
  font-size: 15px;
  color: var(--ink-primary);
  background: transparent;
}

.query-submit-action {
  border: none;
  background-color: var(--ink-primary);
  color: #fff;
  font-weight: 700;
  font-size: 13px;
  padding: 10px 22px;
  border-radius: 999px;
  cursor: pointer;
  transition: opacity 0.2s;
}

.query-submit-action:hover {
  opacity: 0.9;
}

/* -------------------------------------------------------------
 * 6. FOOTER UTILITY & EMOTION TUNER
 * ----------------------------------------------------------- */
.footer-utility-bar {
  position: absolute;
  bottom: 608px; /* 18 */
  left: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  z-index: 40;
}

.emotion-tuner {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(12px);
  padding: 6px 12px;
  border-radius: 999px;
  border: 1px solid var(--border-line);
}

.tuner-title {
  font-size: 10px;
  font-weight: 800;
  color: var(--ink-tertiary);
  font-family: ui-monospace, monospace;
  margin-right: 4px;
}

.tune-chip {
  border: none;
  background: var(--surface-subtle);
  color: var(--ink-secondary);
  font-size: 11px;
  font-weight: 700;
  padding: 5px 12px;
  border-radius: 999px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.tune-chip:hover {
  background: var(--border-line-hover);
  color: var(--ink-primary);
}

.tune-chip.chip-active {
  background: var(--ink-primary);
  color: #fff;
}

.tune-chip.alert-chip.chip-active {
  background: var(--accent-red);
}

/* -------------------------------------------------------------
 * 8. MODAL SHEET (Companion scam alert — shared)
 * ----------------------------------------------------------- */
.modal-backdrop-blur {
  position: fixed;
  inset: 0;
  background: rgba(24, 25, 27, 0.4);
  backdrop-filter: blur(8px);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
}

.tactile-alert-sheet {
  background: var(--surface-white);
  border-radius: 28px;
  padding: 32px;
  max-width: 440px;
  width: 90%;
  box-shadow: 0 30px 60px rgba(0, 0, 0, 0.18);
  border: 1px solid var(--border-line);
  text-align: center;
}

.sheet-stripe {
  height: 4px;
  width: 48px;
  background: var(--accent-red);
  border-radius: 999px;
  margin: 0 auto 16px auto;
}

.alert-sheet-title {
  font-size: 16px;
  font-weight: 900;
  color: var(--accent-red);
  letter-spacing: 0.5px;
  margin-bottom: 20px;
}

.sheet-field {
  background: var(--surface-subtle);
  padding: 12px;
  border-radius: 14px;
  margin-bottom: 14px;
}

.field-lbl {
  display: block;
  font-size: 10px;
  font-weight: 800;
  color: var(--ink-secondary);
}

.field-val {
  font-size: 18px;
  font-weight: 800;
  color: var(--accent-red);
  font-family: ui-monospace, monospace;
}

.sheet-quote {
  font-size: 14px;
  color: var(--ink-secondary);
  font-style: italic;
  margin-bottom: 24px;
}

.safety-resolve-btn {
  width: 100%;
  padding: 14px;
  border-radius: 16px;
  border: none;
  background: var(--accent-red);
  color: #fff;
  font-size: 14px;
  font-weight: 800;
  cursor: pointer;
  box-shadow: 0 4px 14px rgba(220, 38, 38, 0.3);
}
